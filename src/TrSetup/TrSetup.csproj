<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!--
          Target frameworks — fully OS-conditional both ways (REQ-FN-030 FIX 2026-07-11).
          On Windows/WSL the list is net10.0-windows only (the active head, build ladder rung #4);
          the IsOSPlatform('OSX') condition is false there, so the second line never applies and the
          Windows-side build is untouched. On macOS the second line REPLACES the list with
          net10.0-maccatalyst only (ADR-006) — it must not merely append, because restore would then
          still evaluate the windows TFM on the Mac and fail with NETSDK1100 (Windows targeting not
          enabled). Building/validating maccatalyst happens ON the Mac (Cluster I).
        -->
        <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0-maccatalyst</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>TrSetup</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>TrSetup</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.techierathore.trsetup</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Windows unpackaged exe (ADR-001 / BuildAndRun-Guide) -->
        <WindowsPackageType>None</WindowsPackageType>

        <!--
          Embed the Win32 application manifest into the unpackaged Windows exe (windows TFM only).
          The manifest's <compatibility> + asInvoker <trustInfo> exempt TrSetup.exe from the
          Program Compatibility Assistant installer-detection heuristic (the exe name contains
          "Setup"), fixing the false "might not have installed correctly" popup. maccatalyst is
          unaffected — the condition scopes this to the windows target only. (REQ-FN-030 follow-up.)
        -->
        <ApplicationManifest Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">Platforms\Windows\app.manifest</ApplicationManifest>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!--
      Mac Catalyst ad-hoc signing (BRD-44 / REQ-FN-030) — a personal, locally-built, unnotarised .app.
      CodesignKey '-' is codesign's ad-hoc identity (same as `codesign -s -`), so the build needs no
      Apple Developer certificate; CreatePackage=false emits a runnable `.app` bundle rather than a
      `.pkg` installer. This block is scoped to the maccatalyst TFM, which only materialises on macOS
      (see the guarded TargetFrameworks above), so the Windows-side build is completely untouched.
      Gatekeeper quarantine on the copied .app is cleared with `xattr -dr com.apple.quarantine` — see
      the BuildAndRun guide §3 Option A / Option B Step 3.
    -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <CodesignKey>-</CodesignKey>
        <CreatePackage>false</CreatePackage>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <!--
      Serilog file-based logging for the MAUI head (REQ-NFR-007 / BRD-55). All four packages are
      cross-platform (netstandard2.0), so a plain PackageReference applies safely to both the
      windows and (macOS-only) maccatalyst targets without leaking into the shared libraries, which
      log purely through Microsoft.Extensions.Logging abstractions.
    -->
    <ItemGroup>
        <PackageReference Include="Serilog" Version="4.2.0" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- Thin head: all screens live in the TrSetupUI RCL (ADR-001). -->
        <ProjectReference Include="..\TrSetupUI\TrSetupUI.csproj" />
    </ItemGroup>

</Project>
