<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:rcl="clr-namespace:TrSetupUI;assembly=TrSetupUI"
             x:Class="TrSetup.MainPage"
             AutomationId="TrSetupMainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" AutomationId="TrSetupBlazorWebView">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type rcl:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
