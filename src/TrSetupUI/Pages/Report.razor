@page "/report"
@inherits BoardComponentBase
@inject ReportExporter Exporter
@inject IJSRuntime Js
@inject ToastService Toast

@* Report preview (REQ-UI-005): rendered board report with host/roles/app header, per-group
   status tables and Save-as-MD / Save-as-HTML / Copy actions. No secret values in output. *@
<PageTitle>TrSetup — Report</PageTitle>

<header class="ts-topbar">
    <SidebarTrigger />
    <h1 class="ts-page-title">Report preview</h1>
</header>

<main class="ts-content ts-content-narrow">
    @if (Board.Board is not { } vBoard || !HasAnyDetected(vBoard))
    {
        <div class="ts-empty" data-testid="ReportEmpty">
            <LucideIcon Name="file-text" Size="40" />
            <div class="ts-empty-title">Run a check sweep first</div>
            <Button Variant="ButtonVariant.Outline" OnClick="@(() => Nav.NavigateTo("/"))">
                <LucideIcon Name="layout-dashboard" Size="16" />
                <span>Back to board</span>
            </Button>
        </div>
    }
    else
    {
        <div class="ts-toolbar">
            <Button Variant="ButtonVariant.Outline" OnClick="@(() => SaveAsync(false))" data-testid="SaveMarkdownButton">
                <LucideIcon Name="file-down" Size="16" />
                <span>Save as .md</span>
            </Button>
            <Button Variant="ButtonVariant.Outline" OnClick="@(() => SaveAsync(true))" data-testid="SaveHtmlButton">
                <LucideIcon Name="file-code" Size="16" />
                <span>Save as .html</span>
            </Button>
            <Button Variant="ButtonVariant.Outline" OnClick="CopyAsync" data-testid="CopyReportButton">
                <LucideIcon Name="copy" Size="16" />
                <span>Copy markdown</span>
            </Button>
            <span class="ts-toolbar-note">Snapshot of the board at export time — run "Re-check all" first to refresh.</span>
        </div>

        <article class="card ts-rep-card" data-testid="ReportPreview">
            <header class="ts-rep-h">
                <h2 class="ts-rep-title">TrSetup Report — @objHost</h2>
                <div class="ts-rep-meta">
                    @DateTimeOffset.Now.ToString("yyyy-MM-dd HH:mm") · Roles: @RolesText(vBoard) · App: @(vBoard.SelectedApp ?? "Framework only")
                </div>
                <div class="ts-rep-badges">
                    <Badge Class="ts-badge-pass">@TotalPass(vBoard) ✓ pass</Badge>
                    <Badge Class="ts-badge-warn">@TotalWarn(vBoard) ⚠ warn</Badge>
                    <Badge Class="ts-badge-fail">@TotalFail(vBoard) ✗ fail</Badge>
                </div>
            </header>

            <div class="ts-rep-body">
                @foreach (var vGroup in vBoard.Groups.Where(aGroup => aGroup.Rows.Any(aRow => aRow.IsInScope)))
                {
                    <h3>@vGroup.Name</h3>
                    <div class="ts-tbl-wrap">
                        <table class="ts-tbl" data-testid="@($"report-table-{Slug(vGroup.Name)}")">
                            <thead>
                                <tr><th class="ts-col-status">Status</th><th>Check</th><th>Evidence</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var vRow in vGroup.Rows.Where(aRow => aRow.IsInScope))
                                {
                                    <tr data-testid="@($"report-row-{vRow.Check.Id}")">
                                        <td><StatusLabel Status="vRow.Status" IconSize="14" /></td>
                                        <td class="ts-chk">
                                            @vRow.Check.Title
                                            @if (IsSecret(vRow.Check))
                                            {
                                                <Badge Variant="BadgeVariant.Outline" Class="ml-1">presence-only</Badge>
                                            }
                                        </td>
                                        <td class="ts-ev">@Evidence(vRow)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <footer class="ts-rep-foot">
                <LucideIcon Name="shield" Size="14" />
                Generated by TrSetup — safe to paste into a Claude session (no secret values).
            </footer>
        </article>
    }
</main>

@code {
    private readonly string objHost = Environment.MachineName;

    private static bool HasAnyDetected(CheckBoard aBoard)
        => aBoard.Rows.Any(aRow => aRow.IsInScope && aRow.Status is not null);

    private static int TotalPass(CheckBoard aBoard) => aBoard.Groups.Sum(aGroup => aGroup.PassCount);

    private static int TotalWarn(CheckBoard aBoard) => aBoard.Groups.Sum(aGroup => aGroup.WarnCount);

    private static int TotalFail(CheckBoard aBoard) => aBoard.Groups.Sum(aGroup => aGroup.FailCount);

    private static string RolesText(CheckBoard aBoard)
        => aBoard.Roles == MachineRole.None
            ? "(none)"
            : string.Join(" + ", RoleCatalog.Expand(aBoard.Roles).Select(aOption => aOption.Title));

    private static bool IsSecret(Check aCheck)
        => aCheck.Id.Contains("secret", StringComparison.OrdinalIgnoreCase)
           || aCheck.Title.Contains("secret", StringComparison.OrdinalIgnoreCase);

    private static string Evidence(BoardRow aRow)
    {
        if (IsSecret(aRow.Check))
        {
            return "present (value never shown)";
        }

        return string.IsNullOrWhiteSpace(aRow.Evidence) ? "(no evidence captured)" : aRow.Evidence;
    }

    private async Task SaveAsync(bool aIsHtml)
    {
        if (Board.Board is not { } vBoard)
        {
            return;
        }

        try
        {
            var vExtension = aIsHtml ? "html" : "md";
            var vContent = aIsHtml ? Exporter.BuildHtml(vBoard, objHost) : Exporter.BuildMarkdown(vBoard, objHost);
            var vPath = Path.Combine(Environment.CurrentDirectory, $"TrSetup-Report-{SafeHost}.{vExtension}");
            await File.WriteAllTextAsync(vPath, vContent);
            Toast.Success($"Saved {vPath}", "Report saved");
        }
        catch (Exception vEx)
        {
            Toast.Error(vEx.Message, "Save failed");
        }
    }

    private async Task CopyAsync()
    {
        if (Board.Board is not { } vBoard)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", Exporter.BuildMarkdown(vBoard, objHost));
            Toast.Success("Report copied to clipboard.", "Copied");
        }
        catch (JSException)
        {
            Toast.Error("Could not access the clipboard.", "Copy failed");
        }
    }

    private string SafeHost => new string(objHost.Select(aChar => char.IsLetterOrDigit(aChar) ? aChar : '-').ToArray()).Trim('-');

    private static string Slug(string aText)
        => new string(aText.ToLowerInvariant().Select(aChar => char.IsLetterOrDigit(aChar) ? aChar : '-').ToArray()).Trim('-');
}
